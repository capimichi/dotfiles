#!/bin/bash
# .tmux.conf hash: {{ include "private_dot_config/tmux/tmux.conf" | sha256sum }}
set -euo pipefail

PLUGINS_DIR="$HOME/.config/tmux/plugins"
CONF="$HOME/.config/tmux/tmux.conf"

mkdir -p "$PLUGINS_DIR"

# Clona ogni plugin dichiarato con "set -g @plugin 'user/repo'" (non serve un server tmux attivo)
grep -oE "@plugin '[^']+'" "$CONF" | sed -E "s/@plugin '([^']+)'/\1/" | while read -r repo; do
    dest="$PLUGINS_DIR/$(basename "$repo")"
    if [ ! -d "$dest/.git" ]; then
        echo "==> Clonazione $repo (con submoduli)..."
        if [ -d "$dest" ]; then
            tmp_clone="$(mktemp -d)"
            git clone --depth 1 --recurse-submodules "https://github.com/$repo" "$tmp_clone"
            cp -R "$tmp_clone/." "$dest/"
            rm -rf "$tmp_clone"
        else
            git clone --depth 1 --recurse-submodules "https://github.com/$repo" "$dest"
        fi
    else
        # Assicura che i submoduli siano aggiornati/inizializzati
        git -C "$dest" submodule update --init --recursive 2>/dev/null || true
    fi
done

# tmux-fingers richiede un binario: lo scarichiamo dalla release invece di passare dal wizard interattivo
FINGERS_DIR="$PLUGINS_DIR/tmux-fingers"
if [ -d "$FINGERS_DIR" ] && [ ! -x "$FINGERS_DIR/bin/tmux-fingers" ] && ! command -v tmux-fingers >/dev/null 2>&1; then
    case "$(uname -s)-$(uname -m)" in
        Darwin-arm64) suffix="macos-arm64" ;;
        Linux-x86_64) suffix="linux-x86_64" ;;
        *) suffix="" ;;
    esac
    if [ -n "$suffix" ]; then
        version="$(grep '^version' "$FINGERS_DIR/shard.yml" | cut -d: -f2 | tr -d ' ')"
        echo "==> Download binario tmux-fingers $version ($suffix)..."
        mkdir -p "$FINGERS_DIR/bin"
        curl -fsSL "https://github.com/Morantron/tmux-fingers/releases/download/$version/tmux-fingers-$version-$suffix" -o "$FINGERS_DIR/bin/tmux-fingers"
        chmod +x "$FINGERS_DIR/bin/tmux-fingers"
    else
        echo "==> Nessun binario tmux-fingers per $(uname -s) $(uname -m): installalo con il wizard (prefix + I)"
    fi
fi
