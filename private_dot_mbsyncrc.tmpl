# ==============================================================================
# mbsync configuration (Autogenerated via chezmoi & Bitwarden)
# ==============================================================================
{{- $env := .environment }}
{{- $mailConfig := index .mail $env }}

{{- range $acc := $mailConfig.accounts }}
{{- $item := (bitwarden "item" $acc.id) }}
{{- $fields := (bitwardenFields "item" $acc.id) }}
{{- $password := $item.login.password }}
{{- if hasKey $fields "app_password" }}
  {{- if $fields.app_password.value }}
    {{- $password = (replace " " "" $fields.app_password.value) }}
  {{- end }}
{{- end }}

# ------------------------------------------------------------------------------
# Account: {{ $item.login.username }}
# ------------------------------------------------------------------------------
IMAPAccount {{ $item.login.username }}
Host {{ $fields.imap_host.value }}
Port {{ $fields.imap_port.value }}
User {{ $item.login.username }}
{{- if or (eq $fields.imap_host.value "outlook.office365.com") (eq $fields.imap_host.value "imap-mail.outlook.com") }}
AuthMechs XOAUTH2
PassCmd "{{ $.chezmoi.homeDir }}/.local/bin/mutt_oauth2.py {{ $.chezmoi.homeDir }}/.local/state/email/{{ $item.login.username }}.tokens"
{{- else }}
AuthMechs LOGIN PLAIN
Pass {{ $password | quote }}
{{- end }}
{{- if eq $fields.imap_encryption.value "tls" }}
TLSType IMAPS
{{- else }}
TLSType STARTTLS
{{- end }}
CertificateFile {{ if eq $.chezmoi.os "darwin" }}/etc/ssl/cert.pem{{ else }}/etc/ssl/certs/ca-certificates.crt{{ end }}
Timeout 120
PipelineDepth 10

IMAPStore {{ $item.login.username }}-remote
Account {{ $item.login.username }}

MaildirStore {{ $item.login.username }}-local
SubFolders Verbatim
Path ~/.local/share/mail/{{ $item.login.username }}/
Inbox ~/.local/share/mail/{{ $item.login.username }}/INBOX

Channel {{ $item.login.username }}
Far :{{ $item.login.username }}-remote:
Near :{{ $item.login.username }}-local:
Patterns *
Create Both
Expunge Both
CopyArrivalDate yes
SyncState *

{{- end }}

# ------------------------------------------------------------------------------
# Sync Groups
# ------------------------------------------------------------------------------
Group all
{{- range $acc := $mailConfig.accounts }}
{{- $item := (bitwarden "item" $acc.id) }}
Channel {{ $item.login.username }}
{{- end }}
