# ==============================================================================
# Homebrew (macOS Apple Silicon, macOS Intel, Linuxbrew)
# ==============================================================================
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ==============================================================================
# PATH & Environment Variables (Portabili con $HOME)
# ==============================================================================
# User local bin & Python virtualenv
export PATH="$HOME/.local/bin:$HOME/.venv/bin:$PATH"

# Development & tools
export PATH="$PATH:$HOME/miniconda3/bin"
export PATH="$PATH:$HOME/bentosdk/bin"
export PATH="$PATH:$HOME/N_m3u8DL-RE/bin"
export PATH="$PATH:$HOME/go/bin"

# Docker Desktop (macOS)
[[ -d "/Applications/Docker.app/Contents/Resources/bin" ]] && export PATH="$PATH:/Applications/Docker.app/Contents/Resources/bin"

# Laravel Herd Lite
if [[ -d "$HOME/.config/herd-lite/bin" ]]; then
    export PATH="$HOME/.config/herd-lite/bin:$PATH"
    export PHP_INI_SCAN_DIR="$HOME/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"
fi

# Antigravity CLI & IDE
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# ==============================================================================
# Environment-specific Configurations (personal / work)
# ==============================================================================
if [[ -d "$HOME/.config/zsh/envs" ]]; then
    for env_file in "$HOME/.config/zsh/envs"/*.zsh; do
        if [[ -f "$env_file" ]]; then
            source "$env_file"
        fi
    done
fi

# ==============================================================================
# Completions & Shell Features
# ==============================================================================
fpath+=~/.zfunc
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# iTerm2 Shell Integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# ==============================================
# Zoxide (Smarter cd command)
# ==============================================
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# ==============================================
# fzf (Ctrl+R cronologia, Ctrl+T file, **<Tab> completamento)
# ==============================================
if command -v fzf &> /dev/null; then
    if fzf --zsh &> /dev/null; then
        # Il walker integrato parte dalla cartella corrente: niente link simbolici (in ~/Library/Containers
        # moltiplicano le stesse cartelle) e salta le directory enormi che non si cercano mai a mano
        FZF_WALKER_SKIP=".git,node_modules,vendor,Library,.Trash,.cache,.npm,.pub-cache,.rustup"
        export FZF_CTRL_T_OPTS="--walker file,dir,hidden --walker-skip $FZF_WALKER_SKIP"
        export FZF_ALT_C_OPTS="--walker dir,hidden --walker-skip $FZF_WALKER_SKIP"
        export FZF_COMPLETION_PATH_OPTS="--walker file,dir,hidden --walker-skip $FZF_WALKER_SKIP"
        export FZF_COMPLETION_DIR_OPTS="--walker dir,hidden --walker-skip $FZF_WALKER_SKIP"
        source <(fzf --zsh)
    else
        # fzf < 0.48 (pacchetti delle distro) non ha --zsh: usa gli script distribuiti col pacchetto
        for fzf_file in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh /usr/share/fzf/{key-bindings,completion}.zsh; do
            [[ -f "$fzf_file" ]] && source "$fzf_file"
        done
    fi
fi

# ==============================================================================
# Local & Private Configurations (Non versionate)
# ==============================================================================
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
