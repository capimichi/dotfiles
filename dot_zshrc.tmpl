# ==============================================================================
# Homebrew (macOS Apple Silicon, macOS Intel, Linuxbrew)
# ==============================================================================
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ==============================================================================
# XDG Base Directory Specification
# ==============================================================================
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Tool-specific XDG Specifications
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export ANDROID_USER_HOME="$XDG_DATA_HOME/android"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
export COMPOSER_HOME="$XDG_CONFIG_HOME/composer"
export BUN_INSTALL="$XDG_DATA_HOME/bun"
export npm_config_cache="$XDG_CACHE_HOME/npm"
export ANSIBLE_HOME="$XDG_DATA_HOME/ansible"
export ANSIBLE_VAULT_PASSWORD_FILE="$XDG_CONFIG_HOME/ansible/vault_password"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"
export VAGRANT_HOME="$XDG_DATA_HOME/vagrant.d"
export IPYTHONDIR="$XDG_CONFIG_HOME/ipython"
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"
export MPLCONFIGDIR="$XDG_CONFIG_HOME/matplotlib"
export MITMPROXY_PATH="$XDG_CONFIG_HOME/mitmproxy"
export W3M_DIR="$XDG_DATA_HOME/w3m"
export GOPATH="$XDG_DATA_HOME/go"
export STREAMLIT_CONFIG_DIR="$XDG_CONFIG_HOME/streamlit"
export WDM_CACHE_PATH="$XDG_CACHE_HOME/wdm"
export WP_CLI_CACHE_DIR="$XDG_CACHE_HOME/wp-cli"
export WPSCAN_USER_DIR="$XDG_DATA_HOME/wpscan"

# AI / Machine Learning Caches
export HF_HOME="$XDG_CACHE_HOME/huggingface"
export EASYOCR_MODULE_PATH="$XDG_DATA_HOME/easyocr"
export KERAS_HOME="$XDG_DATA_HOME/keras"
export MODELSCOPE_CACHE="$XDG_CACHE_HOME/modelscope"
export PADDLE_HOME="$XDG_CACHE_HOME/paddle"
export U2NET_HOME="$XDG_CACHE_HOME/u2net"
export OLLAMA_MODELS="$XDG_DATA_HOME/ollama/models"

# Cyrus SASL Plugin Path (for mbsync XOAUTH2 support)
export SASL_PATH="$HOME/.local/lib/sasl2:/usr/lib/sasl2"

# ==============================================================================
# PATH & Environment Variables (Portabili con $HOME)
# ==============================================================================
# User local bin & Python virtualenv
export PATH="$HOME/.local/bin:$HOME/.venv/bin:$PATH"

# Development & tools
[[ -d "$CARGO_HOME/bin" ]] && export PATH="$PATH:$CARGO_HOME/bin"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$PATH:$BUN_INSTALL/bin"
export PATH="$PATH:$HOME/miniconda3/bin"
export PATH="$PATH:$HOME/bentosdk/bin"
[[ -d "$GOPATH/bin" ]] && export PATH="$PATH:$GOPATH/bin"

# Docker Desktop (macOS)
[[ -d "/Applications/Docker.app/Contents/Resources/bin" ]] && export PATH="$PATH:/Applications/Docker.app/Contents/Resources/bin"

# Laravel Herd Lite
if [[ -d "$HOME/.config/herd-lite/bin" ]]; then
    export PATH="$HOME/.config/herd-lite/bin:$PATH"
    export PHP_INI_SCAN_DIR="$HOME/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"
fi

# Antigravity CLI & IDE
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# ==============================================================================
# Environment-specific Configurations (personal / work)
# ==============================================================================
if [[ -d "$HOME/.config/zsh/envs" ]]; then
    for env_file in "$HOME/.config/zsh/envs"/*.zsh; do
        if [[ -f "$env_file" ]]; then
            source "$env_file"
        fi
    done
fi

# ==============================================================================
# Completions & Shell Features
# ==============================================================================
[[ -d "$HOME/.config/zsh/functions" ]] && fpath=("$HOME/.config/zsh/functions" $fpath)
[[ -d "$HOME/.zfunc" ]] && fpath+=~/.zfunc
autoload -Uz compinit && compinit

zstyle ':completion:*' menu select

# iTerm2 Shell Integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# ==============================================
# Zoxide (Smarter cd command)
# ==============================================
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# ==============================================
# fzf: Ctrl+R (cronologia) e completamento on-demand (**<Tab>)
# ==============================================
if command -v fzf &> /dev/null; then
    if fzf --zsh &> /dev/null; then
        source <(fzf --zsh)
    else
        # fzf < 0.48 (pacchetti delle distro) non ha --zsh: usa gli script distribuiti col pacchetto
        for fzf_file in /usr/share/doc/fzf/examples/key-bindings.zsh /usr/share/fzf/key-bindings.zsh; do
            [[ -f "$fzf_file" ]] && source "$fzf_file"
        done
        for fzf_comp in /usr/share/doc/fzf/examples/completion.zsh /usr/share/fzf/completion.zsh; do
            [[ -f "$fzf_comp" ]] && source "$fzf_comp"
        done
    fi
    # Disabilita scorciatoie ricorsive automatiche (Ctrl+T e Alt+C) per evitare scansioni pesanti dell'intera home
    for fzf_keymap in emacs viins vicmd; do
        bindkey -M $fzf_keymap -r '^T' '\ec'
    done
fi

# ==============================================================================
# Tmux: Fix soft-wrap selections in terminal emulators (Ghostty/Alacritty/iTerm2)
# ==============================================================================
if [[ -n "$TMUX" ]]; then
    autoload -Uz add-zsh-hook
    tmux_fix_soft_wrap_selections() {
        tmux refresh
    }
    add-zsh-hook precmd tmux_fix_soft_wrap_selections
fi

# ==============================================================================
# Local & Private Configurations (Non versionate)
# ==============================================================================
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
