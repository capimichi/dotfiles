# ==============================================================================
# Homebrew (macOS Apple Silicon, macOS Intel, Linuxbrew)
# ==============================================================================
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ==============================================================================
# PATH & Environment Variables (Portabili con $HOME)
# ==============================================================================
# User local bin & Python virtualenv
export PATH="$HOME/.local/bin:$HOME/.venv/bin:$PATH"

# Development & tools
export PATH="$PATH:$HOME/miniconda3/bin"
export PATH="$PATH:$HOME/bentosdk/bin"
export PATH="$PATH:$HOME/N_m3u8DL-RE/bin"
export PATH="$PATH:$HOME/go/bin"

# Docker Desktop (macOS)
[[ -d "/Applications/Docker.app/Contents/Resources/bin" ]] && export PATH="$PATH:/Applications/Docker.app/Contents/Resources/bin"

# Laravel Herd Lite
if [[ -d "$HOME/.config/herd-lite/bin" ]]; then
    export PATH="$HOME/.config/herd-lite/bin:$PATH"
    export PHP_INI_SCAN_DIR="$HOME/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"
fi

# Antigravity CLI & IDE
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# ==============================================================================
# MCP & Skills API Credentials (da Bitwarden via Chezmoi)
# ==============================================================================
{{- $paperless := (bitwardenFields "item" "28152e5c-412c-4eb6-a569-b30e011c9890") }}
export PAPERLESS_BASE_URL="{{ $paperless.base_url.value }}"
export PAPERLESS_API_KEY="{{ $paperless.api_key.value }}"

{{- $soulsync := (bitwardenFields "item" "9c849f6c-c11a-4f20-94cb-b496015ea8cd") }}
export SOULSYNC_API_KEY="{{ $soulsync.api_key.value }}"

{{- $stremio := (bitwardenFields "item" "26d507f9-81da-4a15-bf6e-b49500a9ba26") }}
export STREMIO_EMAIL="capimichi@gmail.com"
export STREMIO_AUTH_KEY="{{ $stremio.auth_key.value }}"

{{- $trakt := (bitwardenFields "item" "e43c526a-9e7c-44c6-957d-b48b00da3e84") }}
export TRAKT_CLIENT_ID="{{ $trakt.client_id.value }}"
export TRAKT_CLIENT_SECRET="{{ $trakt.client_secret.value }}"
export TRAKT_ACCESS_TOKEN="{{ $trakt.access_token.value }}"
export TRAKT_REFRESH_TOKEN="{{ $trakt.refresh_token.value }}"

{{- $nuvio := (bitwardenFields "item" "f65045d2-901c-4dac-9273-b46800bbc136") }}
export NUVIO_BASE_URL="{{ $nuvio.base_url.value }}"
export NUVIO_API_KEY="{{ $nuvio.api_key.value }}"
export NUVIO_ACCESS_TOKEN="{{ $nuvio.access_token.value }}"
export NUVIO_REFRESH_TOKEN="{{ $nuvio.refresh_token.value }}"
export NUVIO_EMAIL="capimichi@gmail.com"

{{- $listenbrainz := (bitwardenFields "item" "92faa347-7210-4226-b6b8-b49a00a09631") }}
export LISTENBRAINZ_TOKEN="{{ $listenbrainz.user_token.value }}"

# ==============================================================================
# Completions & Shell Features
# ==============================================================================
fpath+=~/.zfunc
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# iTerm2 Shell Integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# ==============================================================================
# Local & Private Configurations (Non versionate)
# ==============================================================================
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
