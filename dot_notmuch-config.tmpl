# ==============================================================================
# Notmuch configuration (Autogenerated via chezmoi)
# ==============================================================================
{{- $env := .environment }}
{{- $mailConfig := index .mail $env }}
{{- $primary := "" }}
{{- $name := "" }}
{{- $others := list }}
{{- range $acc := $mailConfig.accounts }}
  {{- $item := (bitwarden "item" $acc.id) }}
  {{- if $acc.default }}
    {{- $primary = $item.login.username }}
    {{- $name = $acc.displayName }}
  {{- else }}
    {{- $others = append $others $item.login.username }}
  {{- end }}
{{- end }}

[database]
path={{ $.chezmoi.homeDir }}/.local/share/mail

[user]
name={{ $name }}
primary_email={{ $primary }}
other_email={{ range $others }}{{ . }};{{ end }}

[new]
tags=unread;
ignore=

[search]
exclude_tags=deleted;spam;

[maildir]
synchronize_flags=true
