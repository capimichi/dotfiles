# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Tool-specific XDG Specifications
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export ANDROID_USER_HOME="$XDG_DATA_HOME/android"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
export COMPOSER_HOME="$XDG_CONFIG_HOME/composer"
export BUN_INSTALL="$XDG_DATA_HOME/bun"
export npm_config_cache="$XDG_CACHE_HOME/npm"
export ANSIBLE_HOME="$XDG_DATA_HOME/ansible"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"
export VAGRANT_HOME="$XDG_DATA_HOME/vagrant.d"
export IPYTHONDIR="$XDG_CONFIG_HOME/ipython"
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"
export MPLCONFIGDIR="$XDG_CONFIG_HOME/matplotlib"
export MITMPROXY_PATH="$XDG_CONFIG_HOME/mitmproxy"
export W3M_DIR="$XDG_DATA_HOME/w3m"
export GOPATH="$XDG_DATA_HOME/go"
export STREAMLIT_CONFIG_DIR="$XDG_CONFIG_HOME/streamlit"
export WDM_CACHE_PATH="$XDG_CACHE_HOME/wdm"
export WP_CLI_CACHE_DIR="$XDG_CACHE_HOME/wp-cli"
export WPSCAN_USER_DIR="$XDG_DATA_HOME/wpscan"

# AI / Machine Learning Caches
export HF_HOME="$XDG_CACHE_HOME/huggingface"
export EASYOCR_MODULE_PATH="$XDG_DATA_HOME/easyocr"
export KERAS_HOME="$XDG_DATA_HOME/keras"
export MODELSCOPE_CACHE="$XDG_CACHE_HOME/modelscope"
export PADDLE_HOME="$XDG_CACHE_HOME/paddle"
export U2NET_HOME="$XDG_CACHE_HOME/u2net"
export OLLAMA_MODELS="$XDG_DATA_HOME/ollama/models"

# Cyrus SASL Plugin Path (for mbsync XOAUTH2 support)
export SASL_PATH="$HOME/.local/lib/sasl2:/usr/lib/sasl2"

# Homebrew
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$PATH"

# aerc mail backend default ("notmuch" or "maildir")
export AERC_MAIL_BACKEND="${AERC_MAIL_BACKEND:-notmuch}"

# JetBrains Toolbox
[[ -d "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" ]] && export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
