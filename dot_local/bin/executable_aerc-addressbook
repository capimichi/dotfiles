#!/usr/bin/env python3
"""
aerc-addressbook: Address completion helper for aerc using notmuch
Outputs matching contacts in format: <email>\t<name>
"""
import sys
import json
import subprocess
import os

def main():
    query_arg = sys.argv[1].strip() if len(sys.argv) > 1 else ""

    env = dict(os.environ)
    env["HOME"] = "/Users/michele"
    env["NOTMUCH_CONFIG"] = "/Users/michele/.notmuch-config"
    # Ensure Homebrew path is in PATH
    if "/opt/homebrew/bin" not in env.get("PATH", ""):
        env["PATH"] = f"/opt/homebrew/bin:{env.get('PATH', '')}"

    notmuch_query = "*"
    if query_arg:
        notmuch_query = f"from:*{query_arg}* or to:*{query_arg}*"

    cmd = [
        "notmuch",
        "address",
        "--format=json",
        "--deduplicate=address",
        notmuch_query
    ]

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, env=env)
        if proc.returncode != 0:
            return
        entries = json.loads(proc.stdout)
    except Exception:
        return

    seen = set()
    q_lower = query_arg.lower()

    for item in entries:
        addr = item.get("address", "").strip()
        name = item.get("name", "").strip()
        if not addr or addr.lower() in seen:
            continue
        seen.add(addr.lower())

        if q_lower:
            combined = f"{name} {addr}".lower()
            if q_lower not in combined:
                continue

        if name and name != addr:
            print(f"{addr}\t{name}")
        else:
            print(addr)

if __name__ == "__main__":
    main()
