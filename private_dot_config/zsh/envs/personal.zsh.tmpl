# Worldfilia (Bitwarden: "portal.worldfilia.net")
{{- $worldfilia := (bitwarden "item" "ecf3eeb9-c22c-4157-a028-b15d014f4cc2") }}
{{- $worldfiliaFields := (bitwardenFields "item" "ecf3eeb9-c22c-4157-a028-b15d014f4cc2") }}
export WORLDFILIA_USERNAME="{{ $worldfilia.login.username }}"
export WORLDFILIA_PASSWORD="{{ $worldfilia.login.password }}"
