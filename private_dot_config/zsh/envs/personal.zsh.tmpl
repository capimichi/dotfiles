# ==============================================================================
# Environment: Personal (MCP & Skills API Credentials da Bitwarden)
# ==============================================================================

# Cartella del repo skill (usata nei SKILL.md al posto dei percorsi assoluti)
export USER_SKILLS_DIR="$HOME/workspace/capimichi-skills"
# Paperless-ngx (Bitwarden: "paperless.michelecapicchioni.com capimichi")
{{- $paperless := (bitwardenFields "item" "28152e5c-412c-4eb6-a569-b30e011c9890") }}
export PAPERLESS_BASE_URL="{{ $paperless.base_url.value }}"
export PAPERLESS_API_KEY="{{ $paperless.api_key.value }}"
export PAPERLESS_URL="$PAPERLESS_BASE_URL"
export PAPERLESS_TOKEN="$PAPERLESS_API_KEY"

{{- $soulsync := (bitwardenFields "item" "9c849f6c-c11a-4f20-94cb-b496015ea8cd") }}
export SOULSYNC_API_KEY="{{ $soulsync.api_key.value }}"

{{- $stremio := (bitwardenFields "item" "26d507f9-81da-4a15-bf6e-b49500a9ba26") }}
export STREMIO_EMAIL="capimichi@gmail.com"
export STREMIO_AUTH_KEY="{{ $stremio.auth_key.value }}"

{{- $trakt := (bitwardenFields "item" "e43c526a-9e7c-44c6-957d-b48b00da3e84") }}
export TRAKT_CLIENT_ID="{{ $trakt.client_id.value }}"
export TRAKT_CLIENT_SECRET="{{ $trakt.client_secret.value }}"
export TRAKT_ACCESS_TOKEN="{{ $trakt.access_token.value }}"
export TRAKT_REFRESH_TOKEN="{{ $trakt.refresh_token.value }}"

{{- $nuvio := (bitwardenFields "item" "f65045d2-901c-4dac-9273-b46800bbc136") }}
export NUVIO_BASE_URL="{{ $nuvio.base_url.value }}"
export NUVIO_API_KEY="{{ $nuvio.api_key.value }}"
export NUVIO_ACCESS_TOKEN="{{ $nuvio.access_token.value }}"
export NUVIO_REFRESH_TOKEN="{{ $nuvio.refresh_token.value }}"
export NUVIO_EMAIL="capimichi@gmail.com"

{{- $listenbrainz := (bitwardenFields "item" "92faa347-7210-4226-b6b8-b49a00a09631") }}
export LISTENBRAINZ_TOKEN="{{ $listenbrainz.user_token.value }}"

# GitHub Token (Scadenza: 2 ottobre 2027)
{{- $github := (bitwardenFields "item" "cd77fd0d-ed9c-497f-9b78-b27b0094a7c4") }}
export GITHUB_TOKEN="{{ (index $github "PERSONAL TOKEN").value }}"
export GH_TOKEN="$GITHUB_TOKEN"

# Cloudflare Token & Account
{{- $cloudflare := (bitwardenFields "item" "e1d66fc0-753c-4361-830f-b15d014f4cc2") }}
export CF_API_TOKEN="{{ (index $cloudflare "API TOKEN").value }}"
export CLOUDFLARE_API_TOKEN="$CF_API_TOKEN"
export CLOUDFLARE_ACCOUNT_ID="{{ (index $cloudflare "ACCOUNT ID").value }}"
export CF_ACCOUNT_ID="$CLOUDFLARE_ACCOUNT_ID"

# Hugging Face Token
{{- $huggingface := (bitwardenFields "item" "ebc5f808-ebe0-4f1b-8242-b2ac01653d21") }}
export HF_TOKEN="{{ (index $huggingface "CLI TOKEN").value }}"
export HUGGING_FACE_HUB_TOKEN="$HF_TOKEN"

# Worldfilia (Bitwarden: "portal.worldfilia.net")
{{- $worldfilia := (bitwarden "item" "ecf3eeb9-c22c-4157-a028-b15d014f4cc2") }}
{{- $worldfiliaFields := (bitwardenFields "item" "ecf3eeb9-c22c-4157-a028-b15d014f4cc2") }}
export WORLDFILIA_USERNAME="{{ $worldfilia.login.username }}"
export WORLDFILIA_PASSWORD="{{ $worldfilia.login.password }}"
{{- if hasKey $worldfiliaFields "APIKEY" }}
export WORLDFILIA_API_KEY="{{ (index $worldfiliaFields "APIKEY").value }}"
export WORLDFILIA_TOKEN="$WORLDFILIA_API_KEY"
{{- end }}
{{- if and (hasKey $worldfilia.login "totp") $worldfilia.login.totp }}
export WORLDFILIA_TOTP_SECRET="{{ $worldfilia.login.totp }}"
{{- end }}

# Discord (Bitwarden: "discord.com capimichi")
{{- $discord := (bitwardenFields "item" "d386ec17-5a1c-4da6-81a3-b3e300ccb381") }}
export DISCORD_BOT_TOKEN="{{ (index $discord "BOTTOKEN").value }}"
export DISCORD_TOKEN="$DISCORD_BOT_TOKEN"
export DISCORD_APPLICATION_ID="{{ (index $discord "APPID").value }}"
export DISCORD_APP_ID="$DISCORD_APPLICATION_ID"
export DISCORD_CLIENT_ID="$DISCORD_APPLICATION_ID"
export DISCORD_PUBLIC_KEY="{{ (index $discord "PUBLICKEY").value }}"

# TickTick API (Bitwarden: "ticktick.com")
{{- $ticktick := (bitwardenFields "item" "a4415a3a-3795-4a01-ae6e-b501006a3492") }}
export TICKTICK_APIKEY="{{ index $ticktick "APIKEY" "value" }}"
export TICKTICK_CLI="$USER_SKILLS_DIR/ticktick/scripts/ticktick_cli.py"

# LubeLogger (Bitwarden: "lubelogger.michelecapicchioni.com")
{{- $lubelogger := (bitwarden "item" "9be82328-e3f7-4be4-8932-b50201308e46") }}
{{- $lubeloggerFields := (bitwardenFields "item" "9be82328-e3f7-4be4-8932-b50201308e46") }}
export LUBELOGGER_BASE_URL="https://lubelogger.michelecapicchioni.com"
