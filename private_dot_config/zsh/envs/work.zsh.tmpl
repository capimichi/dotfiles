# ==============================================================================
# Environment: Work
# Inserisci qui le configurazioni, proxy o token specifici per il lavoro
# ==============================================================================
{{- $cloudflare := (bitwardenFields "item" "ff64c8b1-df9c-4917-8f05-333bfbd3c09a") }}
export CF_API_TOKEN="{{ index $cloudflare "API Token" "value" }}"
export CLOUDFLARE_API_TOKEN="{{ index $cloudflare "API Token" "value" }}"

# ServerPlan SSO (Bitwarden: "cpanel sso.serverplan.com thespace")
{{- $serverplan := (bitwarden "item" "414f6b1f-e2ce-4ccc-82fb-87078e9c01f4") }}
export SERVERPLAN_USERNAME="{{ $serverplan.login.username }}"
export SERVERPLAN_PASSWORD="{{ $serverplan.login.password }}"

# Freshdesk API (skill thespace-freshdesk) — Bitwarden: "Freshdesk Ticket Support Thespace"
{{- $freshdesk := (bitwardenFields "item" "8337d65b-933b-4ad2-95e9-4316630934e3") }}
export FRESHDESK_API_KEY="{{ index $freshdesk "APIKEY" "value" }}"
export FRESHDESK_DOMAIN="thespace.freshdesk.com"

# Hostinger API (skill thespace-hostinger) — segreto in XDG config, reso da chezmoi
export HOSTINGER_API_TOKEN="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/hostinger/token" 2>/dev/null)"

# Todoist API (Bitwarden: "app.todoist.com michele.capicchioni@thespacesm.com")
{{- $todoist := (bitwardenFields "item" "0e286434-44de-452c-b491-580799b70ad3") }}
export TODOIST_API_TOKEN="{{ index $todoist "APIKEY" "value" }}"

# TheSpace Grid API admin (skill thespace-grid-migration) — Bitwarden: "Grid Thespace Email manage-grid-thespace.thespacesm.com"
{{- $grid := (bitwarden "item" "56a48462-1485-4b74-b743-cf015fd5ff08") }}
export THESPACE_GRID_URL="{{ (index (bitwardenFields "item" "56a48462-1485-4b74-b743-cf015fd5ff08") "api_url").value }}"
export THESPACE_GRID_USERNAME="{{ $grid.login.username }}"
export THESPACE_GRID_PASSWORD="{{ $grid.login.password }}"
