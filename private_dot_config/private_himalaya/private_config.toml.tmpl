# ==============================================================================
# Himalaya CLI Configuration (Autogenerated via chezmoi & Bitwarden - IMAP/SMTP)
# Reads straight from the IMAP server: full-text search goes through notmuch.
# ==============================================================================
{{- $env := .environment }}
{{- $mailConfig := index .mail $env }}

{{- range $acc := $mailConfig.accounts }}
{{- $item := (bitwarden "item" $acc.id) }}
{{- $fields := (bitwardenFields "item" $acc.id) }}
{{- $password := $item.login.password }}
{{- if hasKey $fields "app_password" }}
  {{- if $fields.app_password.value }}
    {{- $password = (replace " " "" $fields.app_password.value) }}
  {{- end }}
{{- end }}

[accounts.{{ $item.login.username | quote }}]
{{- if $acc.default }}
default = true
{{- end }}
email = {{ $item.login.username | quote }}
display-name = {{ $acc.displayName | quote }}

{{- $oauth := or (eq $fields.imap_host.value "outlook.office365.com") (eq $fields.imap_host.value "imap-mail.outlook.com") }}
{{- if hasKey $fields "auth" }}{{ if eq $fields.auth.value "oauth2" }}{{ $oauth = true }}{{ end }}{{ end }}
{{- $tokenCmd := printf "[%q, %q]" (printf "%s/.local/bin/mutt_oauth2.py" $.chezmoi.homeDir) (printf "%s/.local/state/email/%s.tokens" $.chezmoi.homeDir $item.login.username) }}

# IMAP (read)
{{- if eq $fields.imap_encryption.value "tls" }}
imap.server = "imaps://{{ $fields.imap_host.value }}:{{ $fields.imap_port.value }}"
{{- else }}
imap.server = "imap://{{ $fields.imap_host.value }}:{{ $fields.imap_port.value }}"
imap.starttls = true
{{- end }}
{{- if $oauth }}
imap.sasl.xoauth2.username = {{ $item.login.username | quote }}
imap.sasl.xoauth2.token.command = {{ $tokenCmd }}
{{- else }}
imap.sasl.plain.authcid = {{ $item.login.username | quote }}
imap.sasl.plain.passwd.raw = {{ $password | quote }}
{{- end }}

# SMTP (send)
{{- if eq $fields.smtp_encryption.value "tls" }}
smtp.server = "smtps://{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}"
{{- else }}
smtp.server = "smtp://{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}"
smtp.starttls = true
{{- end }}
{{- if $oauth }}
smtp.sasl.xoauth2.username = {{ $item.login.username | quote }}
smtp.sasl.xoauth2.token.command = {{ $tokenCmd }}
{{- else }}
smtp.sasl.plain.authcid = {{ $item.login.username | quote }}
smtp.sasl.plain.passwd.raw = {{ $password | quote }}
{{- end }}
{{- end }}
