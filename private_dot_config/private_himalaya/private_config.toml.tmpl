# ==============================================================================
# Himalaya CLI Configuration (Autogenerated via chezmoi & Bitwarden - Local Maildir)
# ==============================================================================
{{- $env := .environment }}
{{- $mailConfig := index .mail $env }}

{{- range $acc := $mailConfig.accounts }}
{{- $item := (bitwarden "item" $acc.id) }}
{{- $fields := (bitwardenFields "item" $acc.id) }}
{{- $password := $item.login.password }}
{{- if hasKey $fields "app_password" }}
  {{- if $fields.app_password.value }}
    {{- $password = (replace " " "" $fields.app_password.value) }}
  {{- end }}
{{- end }}

[accounts.{{ $item.login.username | quote }}]
{{- if $acc.default }}
default = true
{{- end }}
email = {{ $item.login.username | quote }}
display-name = {{ $acc.displayName | quote }}

# Backend: Local Maildir (synced via mbsync)
maildir.root = "{{ $.chezmoi.homeDir }}/.local/share/mail/{{ $item.login.username }}"

# SMTP
{{- if eq $fields.smtp_encryption.value "tls" }}
smtp.server = "smtps://{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}"
{{- else }}
smtp.server = "smtp://{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}"
smtp.starttls = true
{{- end }}
smtp.sasl.plain.authcid = {{ $item.login.username | quote }}
smtp.sasl.plain.passwd.raw = {{ $password | quote }}
{{- end }}
