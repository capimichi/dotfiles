# ==============================================================================
# Aerc Configuration (Autogenerated via chezmoi & Bitwarden - Local Maildir / Notmuch)
# ==============================================================================
{{- $env := .environment }}
{{- $mailConfig := index .mail $env }}
{{- $backend := "notmuch" }}
{{- if hasKey . "mail_backend" }}
  {{- $backend = .mail_backend }}
{{- else if hasKey .mail "default_backend" }}
  {{- $backend = .mail.default_backend }}
{{- end }}
{{- if (env "AERC_MAIL_BACKEND") }}
  {{- $backend = (env "AERC_MAIL_BACKEND") }}
{{- end }}
{{- $allEmails := list }}
{{- $defaultItem := "" }}
{{- $defaultAcc := "" }}
{{- $defaultFields := "" }}

{{- range $acc := $mailConfig.accounts }}
  {{- $item := (bitwarden "item" $acc.id) }}
  {{- $allEmails = append $allEmails $item.login.username }}
  {{- if $acc.default }}
    {{- $defaultItem = $item }}
    {{- $defaultAcc = $acc }}
    {{- $defaultFields = (bitwardenFields "item" $acc.id) }}
  {{- end }}
{{- end }}
{{- if not $defaultItem }}
  {{- if gt (len $mailConfig.accounts) 0 }}
    {{- $acc := index $mailConfig.accounts 0 }}
    {{- $defaultItem = (bitwarden "item" $acc.id) }}
    {{- $defaultAcc = $acc }}
    {{- $defaultFields = (bitwardenFields "item" $acc.id) }}
  {{- end }}
{{- end }}

multi-file-strategy = act-all

{{- if $defaultItem }}
[All]
from = {{ $defaultAcc.displayName | quote }} <{{ $defaultItem.login.username }}>
source = notmuch://
query-map = {{ $.chezmoi.homeDir }}/.config/aerc/notmuch-all.map
check-mail-cmd = {{ $.chezmoi.homeDir }}/.local/bin/sync-mail all
check-mail-timeout = 5m
enable-maildir = true
multi-file-strategy = act-all
default = Inbox
postpone = Drafts
folders = Inbox, Unread, Starred, Sent, Drafts, Archive, Spam, Trash
folders-sort = Inbox, Unread, Starred, Sent, Drafts, Archive, Spam, Trash
aliases = {{ range $i, $e := $allEmails }}{{ if $i }}, {{ end }}{{ $e }}{{ end }}
{{- $defaultPassword := $defaultItem.login.password }}
{{- if hasKey $defaultFields "app_password" }}
  {{- if $defaultFields.app_password.value }}
    {{- $defaultPassword = (replace " " "" $defaultFields.app_password.value) }}
  {{- end }}
{{- end }}
{{- $oauth := or (eq $defaultFields.imap_host.value "outlook.office365.com") (eq $defaultFields.imap_host.value "imap-mail.outlook.com") }}
{{- if hasKey $defaultFields "auth" }}{{ if eq $defaultFields.auth.value "oauth2" }}{{ $oauth = true }}{{ end }}{{ end }}
{{- if $oauth }}
outgoing = {{ if eq $defaultFields.smtp_encryption.value "tls" }}smtps{{ else }}smtp{{ end }}+xoauth2://{{ $defaultItem.login.username | urlquery }}@{{ $defaultFields.smtp_host.value }}:{{ $defaultFields.smtp_port.value }}
outgoing-cred-cmd = {{ $.chezmoi.homeDir }}/.local/bin/mutt_oauth2.py {{ $.chezmoi.homeDir }}/.local/state/email/{{ $defaultItem.login.username }}.tokens
{{- else }}
outgoing = {{ if eq $defaultFields.smtp_encryption.value "tls" }}smtps{{ else }}smtp{{ end }}://{{ $defaultItem.login.username | urlquery }}:{{ $defaultPassword | urlquery }}@{{ $defaultFields.smtp_host.value }}:{{ $defaultFields.smtp_port.value }}
{{- end }}

{{ end -}}

{{- range $acc := $mailConfig.accounts }}
{{- $item := (bitwarden "item" $acc.id) }}
{{- $fields := (bitwardenFields "item" $acc.id) }}
{{- $password := $item.login.password }}
{{- if hasKey $fields "app_password" }}
  {{- if $fields.app_password.value }}
    {{- $password = (replace " " "" $fields.app_password.value) }}
  {{- end }}
{{- end }}

[{{ $item.login.username }}]
from = {{ $acc.displayName | quote }} <{{ $item.login.username }}>
{{- if eq $backend "notmuch" }}
source = notmuch://
maildir-account-path = {{ $item.login.username }}
enable-maildir = true
multi-file-strategy = act-all
check-mail-cmd = {{ $.chezmoi.homeDir }}/.local/bin/sync-mail {{ $item.login.username }}
{{- else }}
source = maildir://{{ $.chezmoi.homeDir }}/.local/share/mail/{{ $item.login.username }}
check-mail-cmd = mbsync {{ $item.login.username }}
{{- end }}
default = INBOX
check-mail-timeout = 5m
{{- if eq $fields.imap_host.value "imap.gmail.com" }}
postpone = [Gmail]/Bozze
{{- else if eq $fields.imap_host.value "imap.mail.yahoo.com" }}
postpone = Draft
{{- else if eq $fields.imap_host.value "imapmail.libero.it" }}
postpone = draft
{{- else }}
postpone = Drafts
{{- end }}
{{- $oauth := or (eq $fields.imap_host.value "outlook.office365.com") (eq $fields.imap_host.value "imap-mail.outlook.com") }}
{{- if hasKey $fields "auth" }}{{ if eq $fields.auth.value "oauth2" }}{{ $oauth = true }}{{ end }}{{ end }}
{{- if $oauth }}
outgoing = {{ if eq $fields.smtp_encryption.value "tls" }}smtps{{ else }}smtp{{ end }}+xoauth2://{{ $item.login.username | urlquery }}@{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}
outgoing-cred-cmd = {{ $.chezmoi.homeDir }}/.local/bin/mutt_oauth2.py {{ $.chezmoi.homeDir }}/.local/state/email/{{ $item.login.username }}.tokens
{{- else }}
outgoing = {{ if eq $fields.smtp_encryption.value "tls" }}smtps{{ else }}smtp{{ end }}://{{ $item.login.username | urlquery }}:{{ $password | urlquery }}@{{ $fields.smtp_host.value }}:{{ $fields.smtp_port.value }}
{{- end }}
{{- if ne $fields.imap_host.value "imap.gmail.com" }}
copy-to = Sent
{{- end }}

{{ end -}}
