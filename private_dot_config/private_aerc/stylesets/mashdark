# vim: ft=dosini
#
# aerc mashdark styleset
# Palette ripresa dalla skin MashDark di Midnight Commander
# (~/.local/share/mc/skins/mashdark.ini, github.com/notnout/mashdark)
#
#   #FFAF00 ambra (hotkey mc)      #D7AF87 sabbia (titoli)
#   #5F5F87 viola-grigio (selez.)  #875F00 marrone (marcati)
#   #875F5F mattone (statusbar)    #5F00AF viola (menu)
#

*.default=true
*.normal=true

title.fg=#DADADA
title.bg=#875F5F
title.bold=true

header.bold=true
header.fg=#D7AF87

tab.fg=#8A8A8A
tab.selected.fg=#121212
tab.selected.bg=#D7AF87
tab.selected.bold=true

border.fg=#444444

dirlist*.selected.bg=#5F5F87
dirlist*.selected.fg=#FFFFFF
dirlist*.selected.bold=false
dirlist*.selected.italic=false
dirlist_unread.fg=#FFAF00
dirlist_unread.bold=true
dirlist_recent.fg=#FFAF00

*error.bold=true
*error.fg=#FF5F5F
*warning.fg=#FFFF87
*success.fg=#87D787

statusline_default.fg=#EEEEEE
statusline_default.bg=#875F5F
statusline_error.fg=#FFFF87
statusline_error.bg=#870000
statusline_error.bold=true

msglist_default.fg=#DADADA
msglist_default.selected.fg=#FFFFFF
msglist_read.fg=#A8A8A8
msglist_read.bold=false
msglist_read.selected.fg=#FFFFFF
msglist_unread.fg=#FFAF00
msglist_unread.bold=true
msglist_unread.selected.fg=#FFAF00
msglist_unread.selected.bold=true
msglist_flagged.fg=#FF5F5F
msglist_flagged.selected.fg=#FF5F5F
msglist_answered.fg=#87AFAF
msglist_deleted.fg=#585858
msglist_thread_context.fg=#6C6C6C
msglist_thread_context.italic=true
msglist_*.selected.bg=#5F5F87
msglist_result.bg=#5F00AF
msglist_marked.fg=#FFFFFF
msglist_marked.bg=#875F00
msglist_marked.bold=true
msglist_marked.selected.fg=#FFFFFF
msglist_marked.selected.bg=#D78700
msglist_pill.reverse=true

part_*.fg=#DADADA
part_mimetype.fg=#8A8A8A
part_*.selected.fg=#FFFFFF
part_*.selected.bg=#5F5F87
part_filename.selected.bold=true

completion_pill.reverse=false
completion_default.fg=#DADADA
completion_default.bg=#303030
completion_default.selected.bg=#5F00AF
completion_default.selected.fg=#EEEEEE

selector_focused.bold=true
selector_focused.fg=#FFFF87
selector_focused.bg=#870000
selector_chooser.bold=false
selector_chooser.fg=#FFFFFF
selector_chooser.bg=#5F5F87

default.selected.bold=false
default.selected.fg=#FFFFFF
default.selected.bg=#5F5F87

[viewer]
*.default=true
*.normal=true
header.bold=true
header.fg=#D7AF87
url.fg=#00D7FF
url.underline=true
signature.dim=true
diff_meta.bold=true
diff_chunk.fg=#87AFAF
diff_add.fg=#87D787
diff_del.fg=#FF5F5F
diff_whitespace.bg=#870000
quote_*.fg=#87AFAF
quote_*.dim=true
quote_1.fg=#AFD7FF
quote_1.dim=false
code.fg=#D7AF87
