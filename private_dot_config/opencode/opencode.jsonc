{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deeprelay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepRelay",
      "options": {
        "baseURL": "https://api.deeprelay.ai/v1",
        "apiKey": "{env:DEEPRELAY_API_KEY}"
      },
      "models": {
        "deeprelay/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (DeepRelay)"
        },
        "deeprelay/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (DeepRelay)"
        },
        "deeprelay/kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro (DeepRelay)"
        },
        "deeprelay/minimax-m3.1-flash": {
          "name": "MiniMax M3.1 Flash (DeepRelay)"
        }
      }
    }
  }
}
