{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium",
    "image_preview": true,
    "grouping": "auto"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true,
  "theme": {
    "name": "system"
  },
  "prompt": {
    "paste": "compact"
  },
  "attention": {
    "notifications": true
  }
}
