{{- if eq .environment "personal" -}}
[home]
type = sftp
host = 192.168.1.100
user = capimichi
port = 22
key_file = ~/.ssh/id_rsa
shell_type = unix
md5sum_command = md5sum
sha1sum_command = sha1sum

[home.root]
type = sftp
host = 192.168.1.100
user = root
port = 22
key_file = ~/.ssh/id_rsa
shell_type = unix
{{- end }}
