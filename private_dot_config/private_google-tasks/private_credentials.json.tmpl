{{- if eq .environment "work" -}}
{{- $google := (bitwardenFields "item" "a62f775f-5199-4ceb-9a83-eb6f4ca618ce") -}}
{
  "installed": {
    "client_id": {{ $google.oauth_client_id.value | quote }},
    "client_secret": {{ $google.oauth_client_secret.value | quote }},
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "redirect_uris": ["http://localhost"]
  }
}
{{- else if eq .environment "personal" -}}
{{- $google := (bitwardenFields "item" "b6a42518-ce88-4c17-826f-b4fd01678f10") -}}
{
  "installed": {
    "client_id": {{ $google.client_id.value | quote }},
    "client_secret": {{ $google.client_secret.value | quote }},
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "redirect_uris": ["http://localhost"]
  }
}
{{- end }}
